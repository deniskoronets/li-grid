{
  "name": "li-grid",
  "version": "0.1.0",
  "description": "Lightweight Vue 3 data grid with server-side filtering, sorting, pagination, column toggling and translations.",
  "keywords": [
    "vue",
    "vue3",
    "grid",
    "datagrid",
    "table",
    "data-table",
    "filters",
    "pagination",
    "sorting"
  ],
  "author": {
    "name": "Denys Koronets",
    "url": "https://github.com/deniskoronets/"
  },
  "license": "Apache-2.0",
  "homepage": "https://deniskoronets.github.io/li-grid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniskoronets/li-grid.git"
  },
  "bugs": {
    "url": "https://github.com/deniskoronets/li-grid/issues"
  },
  "type": "module",
  "main": "./dist/li-grid.umd.cjs",
  "module": "./dist/li-grid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/li-grid.js",
      "require": "./dist/li-grid.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.5.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
